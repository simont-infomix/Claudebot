{
  "name": "todo-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "description": "MCP server + web miniapp to capture decisions that need a human while working with coding agents",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p web/tsconfig.json --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning dist/server.js",
    "dev:web": "vite",
    "dev:desktop": "npm run build && tsc -p tsconfig.electron.json && electron .",
    "build:desktop": "npm run build && tsc -p tsconfig.electron.json && electron-builder --win",
    "icons": "node tools/make-icons.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
