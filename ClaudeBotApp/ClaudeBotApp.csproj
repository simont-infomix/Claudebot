<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Az exe Win32 erőforrásába fordított ikon: ezt mutatja az Intéző és a tálca. -->
    <ApplicationIcon>NeonRobot.ico</ApplicationIcon>

    <!-- Az exe Fájl tulajdonságai lapján (Intéző → jobbklikk → Tulajdonságok → Részletek)
         megjelenő azonosító adatok — enélkül "1.0.0.0", névtelen termékként jelenne meg. -->
    <Version>1.1.0</Version>
    <AssemblyTitle>ClaudeBot</AssemblyTitle>
    <Product>ClaudeBot</Product>
    <Description>Claude Code botokat futtató és ütemező asztali alkalmazás</Description>
  </PropertyGroup>

  <!-- Release buildben önálló (self-contained) a kimenet: a .NET futtatókörnyezet bekerül a
       kimeneti mappába, így a célgépre semmilyen runtime-ot nem kell külön telepíteni. Ez a
       bot-csatorna (ADR-0005) miatt vált fontossá: azzal az ASP.NET Core shared framework is
       előfeltétellé vált, ami nélkül az alkalmazás el sem indul — ezt egy másik gépre telepítve
       nehéz lenne kitalálni. Debug marad framework-dependent, ott a gyors, kicsi build számít.

       AppendRuntimeIdentifierToOutputPath=false: a kimenet a megszokott helyen marad
       (bin\Release\net10.0-windows), nem csúszik egy win-x64 alkönyvtárba — a botok
       munkamappája (Bots\) is ott él, és nem akarjuk, hogy egy build "elveszítse" őket.

       Trimming szándékosan nincs bekapcsolva: az MCP szerver reflectionnel deríti fel a
       tool-okat, a trimmer pedig pont az ilyen, kódból nem látható hivatkozásokat vágná ki. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Ugyanaz az ikon .NET erőforrásként is, hogy futásidőben be tudjuk tölteni az ablak- és a
       tálcaikonhoz — így mindhárom helyen garantáltan ugyanaz a kép jelenik meg. -->
  <ItemGroup>
    <EmbeddedResource Include="NeonRobot.ico" />
  </ItemGroup>

  <!-- A bot-csatorna MCP szervere (ADR-0005) a hoszt folyamatán belül, Kestrelen fut. A
       FrameworkReference adja a Kestrelt/minimal API-t; a http.sys-re épülő HttpListener
       szándékosan nem jött szóba, mert az URL-ACL foglalást igényelhet. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <!-- A react-ui/ a .NET SDK implicit fájl-globbingjától független, saját (npm-mel kezelt) forrásfa —
       ki kell zárni, különben a node_modules/dist tartalma None/Compile item-ként a projektbe kerülne. -->
  <ItemGroup>
    <Compile Remove="react-ui/**" />
    <EmbeddedResource Remove="react-ui/**" />
    <None Remove="react-ui/**" />
  </ItemGroup>

  <PropertyGroup>
    <ReactUiDir>$(MSBuildProjectDirectory)\react-ui</ReactUiDir>
  </PropertyGroup>

  <Target Name="BuildReactUi" BeforeTargets="Build" Condition="Exists('$(ReactUiDir)\package.json')">
    <Exec Command="npm install" WorkingDirectory="$(ReactUiDir)" Condition="!Exists('$(ReactUiDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ReactUiDir)" />
  </Target>

  <!-- A lefordított React UI a kimenet webui\ mappájába kerül — a WebView innen szolgálja ki a
       felületet (ld. Form1.SetVirtualHostNameToFolderMapping).

       A build és a publish külön kezelése szándékos, nem redundancia. A dist\ tartalma csak a build
       KÖZBEN keletkezik (BuildReactUi), ezért egy statikus ItemGroup vagy egy AssignTargetPaths
       idejű ContentWithTargetPath még üres mappát látna: tiszta forrásfából fordítva a webui
       kimaradna a kimenetből. Mindkét target ezért olyan pontra van időzítve, ahol a dist\ már
       biztosan kész. -->
  <Target Name="CopyReactUiOutput" AfterTargets="Build" Condition="Exists('$(ReactUiDir)\dist')">
    <ItemGroup>
      <ReactUiFiles Include="$(ReactUiDir)\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactUiFiles)" DestinationFolder="$(OutDir)webui\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- A publish nem a build kimenetét másolja tovább, hanem saját fájllistát számol — a fenti
       target eredménye ezért nem jut el oda magától. E nélkül a `dotnet publish` csomagja
       felhasználói felület nélkül, üres ablakkal indulna. A ComputeFilesToPublish után a lista már
       összeállt, és a Build (vele a React fordítása) is lefutott. -->
  <Target Name="AddReactUiToPublish" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(ReactUiDir)\dist')">
    <ItemGroup>
      <ReactUiPublishFiles Include="$(ReactUiDir)\dist\**\*.*" />
      <ResolvedFileToPublish Include="@(ReactUiPublishFiles)">
        <RelativePath>webui\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>